# Phi-4-mini-instruct (3.8B) on the vLLM CPU image.
#
# The GPU recipe stays in Dockerfile. This file is what profile llm-cpu runs.
# CPU context is 8192 so the KV cache fits beside the other small models.
# SERVED_NAME matches the catalogue id.
FROM vllm/vllm-openai-cpu:v0.27.1

ENV MODEL_ID=microsoft/Phi-4-mini-instruct \
    SERVED_NAME=phi-4-mini-instruct \
    PORT=8003 \
    MAX_MODEL_LEN=8192 \
    MAX_NUM_SEQS=2 \
    VLLM_CPU_KVCACHE_SPACE=6 \
    VLLM_CPU_OMP_THREADS_BIND=auto

# Same CPU attention tile fix as Phi-3 Mini. This checkpoint uses that kernel.
RUN python -c 'from pathlib import Path; p=Path("/opt/venv/lib/python3.12/site-packages/vllm/v1/attention/backends/cpu_attn.py"); t=p.read_text(); old="if head_size is not None and head_size % 32 != 0 and head_size % 16 == 0:"; new="if head_size is not None and head_size % 16 == 0:"; assert old in t, "cpu attn guard missing"; p.write_text(t.replace(old, new, 1))'

ENV EXTRA_ARGS="--dtype bfloat16 --trust-remote-code --block-size 128"

EXPOSE 8003
ENTRYPOINT ["sh", "-c", "exec vllm serve $MODEL_ID \
  --served-model-name $SERVED_NAME \
  --host 0.0.0.0 --port $PORT \
  --max-model-len $MAX_MODEL_LEN \
  --max-num-seqs $MAX_NUM_SEQS \
  $EXTRA_ARGS"]
