# LLM slot only. Gateway always starts; the llm service needs this profile.
COMPOSE_PROFILES=llm
LLM_MODEL=phi-4-mini-instruct
GATEWAY_PORT=8100

# Phi-4-mini-instruct is capped at 16384 so a 20 GB GPU can load it.
# Gemma 3 4B can use 32768. Match DHARA_LLM_MODEL to LLM_MODEL.
VLLM_MAX_MODEL_LEN=16384
VLLM_GPU_MEMORY_UTILIZATION=0.90
VLLM_MAX_NUM_SEQS=8

# Required for gated Hugging Face weights. Accept the model license first.
# LLM_HF_TOKEN=

# GPU index. Default 0.
# GPU_DEVICE_IDS=0

# Optional extra vLLM, still reached only through the gateway.
# id=url pairs, comma-separated. Example: a second container on :8004.
# LLM_EXTRA_UPSTREAMS=gemma-3-4b=http://127.0.0.1:8004

# Optional cloud model. The gateway proxies this id to OpenAI.
# Callers still use the gateway URL; the key never leaves this file.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com
