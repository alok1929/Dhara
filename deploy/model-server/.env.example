# LLM slot only. Gateway always starts. Enable one model profile:
#   llm      NVIDIA GPU image (vllm/vllm-openai)
#   llm-cpu  CPU image (vllm/vllm-openai-cpu). No GPU. Use with gemma-2-2b-it.
# Do not set both. They share the container name dhara-model-llm.
COMPOSE_PROFILES=llm
LLM_MODEL=phi-4-mini-instruct
# CPU example (replace the two lines above):
# COMPOSE_PROFILES=llm-cpu
# LLM_MODEL=gemma-2-2b-it
GATEWAY_PORT=8100

# Where the gateway reaches the primary vLLM OpenAI port.
# Inside compose: http://llm:8003 (default). On the host with Podman vLLM on :8003:
# LLM_UPSTREAM=http://127.0.0.1:8003

# Phi-4-mini-instruct is capped at 16384 so a 20 GB GPU can load it.
# Gemma 3 4B can use 32768. Match DHARA_LLM_MODEL to LLM_MODEL.
VLLM_MAX_MODEL_LEN=16384
VLLM_GPU_MEMORY_UTILIZATION=0.90
VLLM_MAX_NUM_SEQS=8

# Required for gated Hugging Face weights. Accept the model license first.
# LLM_HF_TOKEN=

# GPU index. Default 0. Unused by profile llm-cpu.
# GPU_DEVICE_IDS=0

# CPU profile only. Gemma 2 2B's native context is 8192.
# VLLM_CPU_KVCACHE_SPACE is GiB of RAM for the KV cache, on top of the weights.
# VLLM_CPU_MAX_MODEL_LEN=8192
# VLLM_CPU_MAX_NUM_SEQS=2
# VLLM_CPU_KVCACHE_SPACE=4
# VLLM_CPU_OMP_THREADS_BIND=auto

# Other servers the gateway should keep reachable. id=url pairs,
# comma-separated. Profile llm-cpu serves every ready model under 5B:
# LLM_EXTRA_UPSTREAMS=bitnet-b1.58-2b=http://bitnet:8003,phi-2=http://phi-2:8003,phi-3-mini-4k-instruct=http://phi-3-mini:8003,phi-4-mini-instruct=http://phi-4-mini:8003,gemma-3-4b=http://gemma-3-4b:8003
# A second container on the host looks like:
# LLM_EXTRA_UPSTREAMS=gemma-3-4b=http://127.0.0.1:8004

# Optional cloud model. The gateway proxies this id to OpenAI.
# Callers still use the gateway URL; the key never leaves this file.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com
